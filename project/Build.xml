<xml>
    <set name="HXCPP_API_LEVEL" value="400" />

    <set name="GLAD_ROOT" value="libs/glad" />
    <set name="GLAD_SRC" value="${GLAD_ROOT}/src" />
    <set name="GLAD_INCLUDE" value="${GLAD_ROOT}/include" />

    <set name="HL_ROOT" value="libs/hashlink" />
    <set name="HL_SRC" value="${HL_ROOT}/src" />
    <set name="HL_INCLUDE" value="${HL_ROOT}/src" />

    <files id="glad_sources">
        <depend name="${GLAD_INCLUDE}" />

        <file name="${GLAD_SRC}/glad.c" />

        <compilerflag value="-I${GLAD_INCLUDE}" />
    </files>

    <files id="haxe">
        <depend name="${HL_INCLUDE}/hl.h" />

        <file name="src/glad.cpp" />

        <compilerflag value="-I${HL_INCLUDE}" />
        <compilerflag value="-I${GLAD_INCLUDE}" />

        <section if="STATIC_HDLL">
            <compilerflag value="-DSTATIC_HDLL" />
        </section>

        <section if="windows">
            <compilerflag value="-std:c++20" />
            <compilerflag value="-D_CRT_SECURE_NO_WARNINGS" />
        </section>
    </files>

    <set name="OUT_ARCH" value="unknown" />

    <section if="windows">
        <set name="OUT_ARCH" value="Windows64" />

        <section unless="HXCPP_M64">
            <error value="Compiling HDLL requires 64 bits. Compile with: haxelib run hxcpp Build.xml -DHXCPP_M64" />
        </section>
    </section>

    <section if="linux">
        <set name="OUT_ARCH" value="Linux64" />
        <section if="HXCPP_M32">
            <set name="OUT_ARCH" value="Linux32" />
            <compilerflag value="-m32" />
            <linkerflag value="-m32" />
        </section>
        <section if="HXCPP_ARM64">
            <set name="OUT_ARCH" value="LinuxArm64" />
        </section>
    </section>

    <section if="mac">
        <set name="OUT_ARCH" value="Mac64" />
        <section if="HXCPP_ARM64">
            <set name="OUT_ARCH" value="MacArm64" />
        </section>
    </section>

    <section unless="windows || linux || mac">
        <error value="Unsopported platform." />
    </section>

    <section if="STATIC_HDLL">
        <target id="default" tool="linker" toolid="static_link" output="glad_static">
            <section if="windows">
                <ext value=".lib" />
            </section>
            <section unless="windows">
                <ext value=".a" />
            </section>
            <outdir name="binaries/${OUT_ARCH}" />

            <files id="haxe" />
            <files id="glad_sources" />
        </target>
    </section>

    <section unless="STATIC_HDLL">
        <target id="default" tool="linker" toolid="dll" output="glad">
            <ext value=".hdll" />
            <outdir name="binaries/${OUT_ARCH}" />

            <files id="haxe" />
            <files id="glad_sources" />

            <section if="windows">
                <lib name="binaries/${OUT_ARCH}/libhl.lib" />
            </section>
            <section if="mac">
                <lib name="-Wl,-undefined,dynamic_lookup" />
            </section>

            <section if="windows">
                <lib name="opengl32.lib" />
                <lib name="gdi32.lib" />
                <lib name="user32.lib" />
                <lib name="shell32.lib" />
                <lib name="winmm.lib" />
            </section>

            <section if="linux">
                <lib name="-lGL" />
                <lib name="-lX11" />
                <lib name="-lpthread" />
                <lib name="-ldl" />
                <lib name="-lm" />
            </section>

            <section if="mac">
                <lib name="-framework Cocoa" />
                <lib name="-framework OpenGL" />
                <lib name="-framework IOKit" />
                <lib name="-framework CoreVideo" />
            </section>
        </target>
    </section>
</xml>